{
  "name": "rhino",
  "version": "0.1.0",
  "description": "A browser-based game where players control a turtle to catch falling objects",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src scripts --ext .ts,.mjs --max-warnings 0",
    "lint:fix": "eslint src scripts --ext .ts,.mjs --fix",
    "format": "prettier --write \"**/*.{ts,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,css,html,md}\"",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && vite build",
    "test:mobile": "npm run build && node scripts/check-mobile.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.0.0",
    "jsdom": "^25.0.0",
    "playwright": "1.56.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  }
}
